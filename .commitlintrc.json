{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "Add",
        "Fix",
        "Update",
        "Refactor",
        "Docs",
        "Style",
        "Test",
        "Build",
        "CI",
        "Chore",
        "add",
        "fix",
        "update",
        "refactor",
        "docs",
        "style",
        "test",
        "build",
        "ci",
        "chore"
      ]
    ],
    "type-case": [0],
    "subject-case": [0],
    "subject-full-stop": [0],
    "body-leading-blank": [2, "always"],
    "footer-leading-blank": [2, "always"]
  }
} 