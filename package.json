{
  "name": "azurepwq-website",
  "version": "1.0.0",
  "description": "Azure PWQ's personal website",
  "private": true,
  "scripts": {
    "start": "npm-run-all --parallel serve watch",
    "serve": "bundle exec jekyll serve --livereload",
    "build": "bundle exec jekyll build",
    "clean": "bundle exec jekyll clean",
    "cname": "echo 'azurepwq.com' > _site/CNAME",
    "test": "bundle exec jekyll doctor",
    "sync": "bash ./sync-readme-to-index.sh",
    "watch": "bash ./watch-and-sync.sh"
  },
  "author": "Azure PWQ",
  "license": "MIT",
  "devDependencies": {
    "husky": "^8.0.0",
    "npm-run-all": "^4.1.5"
  }
} 