{
  "name": "azurepwq-website",
  "version": "1.0.0",
  "description": "azurepwq's personal website",
  "private": true,
  "scripts": {
    "start": "npm-run-all --parallel serve watch",
    "serve": "bundle exec jekyll serve --livereload --force_polling",
    "build": "bundle exec jekyll build",
    "clean": "bundle exec jekyll clean",
    "cname": "echo 'azurepwq.com' > _site/CNAME",
    "test": "bundle exec jekyll doctor",
    "sync": "bash ./scripts/sync-readme-to-index.sh",
    "watch": "nodemon --watch README.md --exec \"npm run sync\" --ext md",
    "commit": "npx git-cz"
  },
  "author": "azurepwq",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^8.0.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
